<project xmlns="http://maven.apache.org/POM/4.0.0"
				 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- This Maven configuration just copies the required Java libraries to the
		library folders. It is just for managing the library dependencies. If you want
		to add a library you also have to add it to the classpath of your RCP
		application (open the plugin.xml in Eclipse, go to the Runtime tab and
		modify the classpath). -->

	<modelVersion>4.0.0</modelVersion>
	<groupId>epd-editor</groupId>
	<artifactId>dependencies</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<dependencies>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>1.0.1</version>
		</dependency>

		<dependency>
			<groupId>org.openlca</groupId>
			<artifactId>olca-ilcd</artifactId>
			<version>4.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.okworx.ilcd.validation.profiles</groupId>
			<artifactId>EPD-1.2-OEKOBAUDAT</artifactId>
			<version>3.8.0</version>
		</dependency>

		<dependency>
			<groupId>com.okworx.ilcd.validation.profiles</groupId>
			<artifactId>EPD-1.2-Generic-EN15804</artifactId>
			<version>2.6.0</version>
		</dependency>

		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.15.0</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.20</version>
		</dependency>

		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.6.8</version>
		</dependency>

		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi</artifactId>
			<version>6.0.0</version>
		</dependency>

		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>6.0.0</version>
		</dependency>

		<!--
		poi and ilcd-validation log via the Log4j API. This bridge routes
		these logs to SLF4J/logback. Keep its version in sync with the
		log4j-api version declared in the poi POM.
		-->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-to-slf4j</artifactId>
			<version>2.26.1</version>
		</dependency>

		<!--
		ilcd-validation is declared last so that the versions of shared
		transitive dependencies are determined by the libraries above.
		Exclusions:
		* log4j-slf4j-impl: an SLF4J 1.x binding; we use SLF4J 2 with logback.
		* log4j-core: ilcd-validation only uses the Log4j API; its logs are
		  routed to logback via log4j-to-slf4j (see above).
		* poi, commons-io, commons-compress: ilcd-validation declares older
		  versions (poi 4.1.2, commons-io 2.8.0, commons-compress 1.25.0) that
		  are incompatible with the POI version used above. The versions now
		  come from poi / poi-ooxml. When updating ilcd-validation, check its
		  POM for new conflicts (mvn dependency:tree -Dverbose).
		-->
		<dependency>
			<groupId>com.okworx.ilcd.validation</groupId>
			<artifactId>ilcd-validation</artifactId>
			<version>3.1.0</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.logging.log4j</groupId>
					<artifactId>log4j-slf4j-impl</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.logging.log4j</groupId>
					<artifactId>log4j-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-io</groupId>
					<artifactId>commons-io</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.commons</groupId>
					<artifactId>commons-compress</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.1.0</version>
				<executions>

					<execution>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/libs</outputDirectory>
							<includeScope>runtime</includeScope>
							<excludeGroupIds>com.okworx.ilcd.validation.profiles</excludeGroupIds>
						</configuration>
					</execution>

					<execution>
						<id>copy-test-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/libs-test</outputDirectory>
							<includeArtifactIds>junit,hamcrest-core</includeArtifactIds>
						</configuration>
					</execution>

					<execution>
						<id>copy-profiles</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${basedir}/build/default_data/validation_profiles
							</outputDirectory>
							<includeGroupIds>com.okworx.ilcd.validation.profiles</includeGroupIds>
						</configuration>
					</execution>

				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${basedir}/libs</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<fileset>
							<directory>${basedir}/libs-test</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<fileset>
							<directory>${basedir}/build/default_data/validation_profiles</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<excludes>
								<exclude>.gitignore</exclude>
							</excludes>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
